# StrataSense Backend Environment Configuration

# Telegram Alert Bot Configuration (Optional for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MQTT Telemetry Broker Settings
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=stratasense/mine/sensor1

# Service URLs
BACKEND_URL=http://localhost:8000
